<Window x:Class="ClipRing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClipRing.UI"
        Title="ClipRing"
        Width="1160" Height="800" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Language="de-DE"
        Icon="/Assets/ClipRing.ico"
        Background="{StaticResource Brush.Ground}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}">

    <Grid Background="{StaticResource Brush.Ground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ navigation rail -->
        <Border Background="{StaticResource Brush.Rail}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,26,16,22">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,30">
                    <Grid Width="30" Height="30">
                        <Ellipse Stroke="{StaticResource Brush.Text}" StrokeThickness="3" />
                        <Ellipse Width="9" Height="9" Fill="{Binding Service.State, Converter={StaticResource StateBrush}}" />
                    </Grid>
                    <TextBlock Text="ClipRing" FontFamily="{StaticResource Font.Display}" FontSize="23" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource LiveDot}" Fill="{Binding Service.State, Converter={StaticResource StateBrush}}" />
                        <TextBlock Text="{Binding Service.StateTitle}" Margin="10,0,0,0" Style="{StaticResource Text.Value}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding VersionText, Mode=OneWay}" Style="{StaticResource Text.Faint}" Margin="20,6,0,0" />
                </StackPanel>

                <ListBox Style="{StaticResource NavList}" SelectedIndex="{Binding SelectedPage}">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE80F;" />
                            <TextBlock Text="Übersicht" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE714;" />
                            <TextBlock Text="Video" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE767;" />
                            <TextBlock Text="Audio" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8B7;" />
                            <TextBlock Text="Speichern" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE765;" />
                            <TextBlock Text="Hotkeys" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE734;" />
                            <TextBlock Text="Highlights" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7FC;" />
                            <TextBlock Text="Spiele" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE713;" />
                            <TextBlock Text="Allgemein" Margin="14,0,0,0" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============================================================ pages -->
        <TabControl Grid.Column="1" Style="{StaticResource PageHost}" SelectedIndex="{Binding SelectedPage}">

            <!-- ======================================== Übersicht -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <Border Style="{StaticResource Sheet}" Padding="32,28,32,24">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Style="{StaticResource LiveDot}"
                                                     Fill="{Binding Service.State, Converter={StaticResource StateBrush}}" />
                                            <TextBlock Text="{Binding Service.StateTitle}" Style="{StaticResource Text.RowTitle}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Text.Timer}" Margin="0,14,0,2"
                                                   Text="{Binding Service.BufferedSeconds, Converter={StaticResource Duration}}" />
                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="13.5">
                                            <Run Text="von" />
                                            <Run Text="{Binding Service.BufferLengthText, Mode=OneWay}" />
                                            <Run Text="im Arbeitsspeicher, belegt" />
                                            <Run Text="{Binding Service.BufferBytesText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <Button Style="{StaticResource PrimaryButton}" Content="Clip speichern"
                                                Command="{Binding SaveClipCommand}" />
                                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Faint}" Margin="0,8,0,0"
                                                   Text="{Binding Settings.HotkeySave}" />
                                    </StackPanel>
                                </Grid>

                                <ui:BufferTape Height="70" Margin="0,26,0,0"
                                               Fill="{Binding Service.BufferFill, Mode=OneWay}"
                                               TotalSeconds="{Binding Settings.BufferSeconds, Mode=OneWay}"
                                               IsLive="{Binding Service.IsRunning, Mode=OneWay}"
                                               FlashCount="{Binding SaveFlashCount, Mode=OneWay}" />

                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,18,0,0" FontSize="13"
                                           Text="{Binding Service.StatusText}" />
                                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0" FontSize="13"
                                           Foreground="{StaticResource Brush.Warn}" Text="{Binding HotkeyErrors}"
                                           Visibility="{Binding HotkeyErrors, Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}" />

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" Margin="0,0,10,0" />
                                    <Button Content="Clip-Ordner öffnen" Command="{Binding OpenOutputFolderCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Zuletzt gespeichert" Style="{StaticResource Text.SectionTitle}" />
                                <Border Style="{StaticResource Sheet}">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding Service.RecentClips}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,13">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" Style="{StaticResource Text.RowTitle}" />
                                                                <TextBlock Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                                                                <TextBlock Text="{Binding FileName, Mode=OneWay}" Style="{StaticResource Text.Faint}"
                                                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                <Button Style="{StaticResource QuietButton}" Content="Abspielen"
                                                                        Command="{Binding DataContext.OpenClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Style="{StaticResource QuietButton}" Content="Im Ordner zeigen"
                                                                        Command="{Binding DataContext.ShowClipCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="20,22" FontSize="13.5"
                                                   Visibility="{Binding Service.RecentClips.Count, Converter={StaticResource EmptyToVisible}}">
                                            <Run Text="Noch keine Clips. Drück" />
                                            <Run Text="{Binding Settings.HotkeySave, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                                            <Run Text="im Spiel, dann landet hier der letzte Moment." />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Aufnahme" Style="{StaticResource Text.SectionTitle}" />
                                <Border Style="{StaticResource Sheet}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="Spiel" Style="{StaticResource Text.Faint}" />
                                        <TextBlock Text="{Binding Service.GameText}" Style="{StaticResource Text.Value}" Margin="0,2,0,12" />
                                        <TextBlock Text="Encoder" Style="{StaticResource Text.Faint}" />
                                        <TextBlock Text="{Binding Service.EncoderText}" Style="{StaticResource Text.Value}" Margin="0,2,0,12" />
                                        <TextBlock Text="Ausgabe" Style="{StaticResource Text.Faint}" />
                                        <TextBlock Text="{Binding Service.OutputText}" Style="{StaticResource Text.Value}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Pegel" Style="{StaticResource Text.SectionTitle}" />
                                <Border Style="{StaticResource Sheet}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Text="PC-Ton" Style="{StaticResource Text.Faint}" />
                                        <ui:LevelMeter Height="8" Margin="0,6,0,14" Level="{Binding Service.SystemPeak, Mode=OneWay}" />
                                        <TextBlock Text="Mikrofon" Style="{StaticResource Text.Faint}" />
                                        <ui:LevelMeter Height="8" Margin="0,6,0,0" Level="{Binding Service.MicPeak, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Video -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Video" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}"
                                   Text="Änderungen auf dieser Seite starten den Replay-Puffer neu, dabei wird er geleert." />

                        <TextBlock Text="Bild" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Monitor" Description="Der Bildschirm, auf dem du spielst.">
                                    <ComboBox Width="280" ItemsSource="{Binding MonitorOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.MonitorIndex}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Auflösung" Description="Wird nur verkleinert, nie vergrößert. Nativ ist am schärfsten.">
                                    <ComboBox Width="280" ItemsSource="{Binding ResolutionOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Resolution}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Bildrate" Description="Mehr als die Bildwiederholrate des Monitors bringt nichts.">
                                    <ComboBox Width="280" ItemsSource="{Binding FpsOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Fps}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Aufnahmemethode"
                                               Description="Beide schaffen hohe Bildraten. Zeigt die Aufnahme eines Spiels Flackern oder alte Bilder (z. B. den Ladebildschirm), die andere Methode probieren.">
                                    <ComboBox Width="280" ItemsSource="{Binding CaptureMethodOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.CaptureMethod}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Mauszeiger aufnehmen" ShowDivider="False">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.CaptureCursor}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Encoder" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Codec"
                                               Description="H.264 läuft überall. HEVC und AV1 sind bei gleicher Qualität deutlich kleiner, brauchen aber eine neuere Grafikkarte.">
                                    <ComboBox Width="280" ItemsSource="{Binding CodecOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Codec}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Encoder"
                                               Description="Automatisch testet NVIDIA, AMD, Intel und Direct3D 12 der Reihe nach und nimmt den ersten, der funktioniert. Software belastet die CPU.">
                                    <ComboBox Width="280" ItemsSource="{Binding EncoderOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Encoder}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="In Verwendung">
                                    <TextBlock Text="{Binding Service.EncoderText}" Style="{StaticResource Text.Value}" MaxWidth="300"
                                               TextAlignment="Right" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Encoder-Tempo" Description="Schnell entlastet die Grafikkarte und schafft auch 4K mit 120 fps. Qualität holt mehr aus derselben Bitrate. Ruckeln Clips, eine Stufe schneller wählen.">
                                    <ComboBox Width="280" ItemsSource="{Binding SpeedOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Speed}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Keyframe-Abstand" ShowDivider="False"
                                               Description="Clips beginnen immer an einem Keyframe. Kürzer schneidet genauer, kostet aber etwas Bitrate.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="200" Minimum="0.5" Maximum="4" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.KeyframeIntervalSec}" VerticalAlignment="Center" />
                                        <TextBlock Width="64" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Settings.KeyframeIntervalSec, StringFormat={}{0:0.0} s}" />
                                    </StackPanel>
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Qualität" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Voreinstellung" Description="Die Bitrate passt sich Auflösung, Bildrate und Codec an.">
                                    <ComboBox Width="280" ItemsSource="{Binding QualityOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Quality}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Bitrate">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding IsCustomBitrate, Converter={StaticResource BoolToVisible}}">
                                            <Slider Width="200" Minimum="2" Maximum="150" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    Value="{Binding CustomBitrateMbps}" VerticalAlignment="Center" />
                                            <TextBlock Width="84" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                       Text="{Binding CustomBitrateMbps, StringFormat={}{0:0} Mbit/s}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Text.Value}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                   Visibility="{Binding IsCustomBitrate, Converter={StaticResource BoolToVisible}, ConverterParameter=invert}">
                                            <Run Text="{Binding Service.EstimatedBitrateText, Mode=OneWay}" />
                                            <Run Text="bei" Foreground="{StaticResource Brush.Muted}" />
                                            <Run Text="{Binding Service.EstimatedOutputText, Mode=OneWay}" Foreground="{StaticResource Brush.Muted}" />
                                        </TextBlock>
                                    </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Ratenkontrolle" ShowDivider="False"
                                               Description="Variabel spart in ruhigen Szenen Platz. Konstant hält die Dateigröße exakt vorhersagbar.">
                                    <ComboBox Width="280" ItemsSource="{Binding RateControlOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.RateControl}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Replay-Puffer" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Länge" Description="So viel hält ClipRing ständig im Arbeitsspeicher vor. Ein Clip ist höchstens so lang.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="200" Minimum="15" Maximum="600" TickFrequency="15" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.BufferSeconds}" VerticalAlignment="Center" />
                                        <TextBlock Width="64" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Service.BufferLengthText}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Speicherbedarf">
                                    <StackPanel HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Service.EstimatedRamText}" Style="{StaticResource Text.Value}" TextAlignment="Right" />
                                        <TextBlock Text="Das ist viel für diesen PC. Kürzere Länge oder niedrigere Bitrate wählen."
                                                   Foreground="{StaticResource Brush.Warn}" Style="{StaticResource Text.Muted}" MaxWidth="300"
                                                   TextAlignment="Right" Margin="0,4,0,0"
                                                   Visibility="{Binding Service.RamWarning, Converter={StaticResource BoolToVisible}}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Nur aufnehmen, wenn ein Spiel läuft" ShowDivider="False"
                                               Description="Startet den Puffer erst, wenn ein Spiel erkannt wird, und stoppt ihn, wenn es beendet ist.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.OnlyWhenGameRunning}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Audio -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Audio" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}"
                                   Text="PC-Ton und Mikrofon werden zu einer Tonspur gemischt. Lautstärke und Geräte lassen sich ändern, ohne dass der Puffer neu startet." />

                        <TextBlock Text="PC-Ton" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="PC-Ton aufnehmen" Description="Alles, was über das gewählte Ausgabegerät läuft: Spiel, Voice-Chat, Musik.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.CaptureSystemAudio}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Ausgabegerät">
                                    <ComboBox Width="300" ItemsSource="{Binding OutputDevices}" DisplayMemberPath="Name"
                                              SelectedValuePath="Id" SelectedValue="{Binding Settings.SystemAudioDeviceId}"
                                              IsEnabled="{Binding Settings.CaptureSystemAudio}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Lautstärke in der Aufnahme" ShowDivider="False">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="220" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    Value="{Binding Settings.SystemVolume}" VerticalAlignment="Center"
                                                    IsEnabled="{Binding Settings.CaptureSystemAudio}" />
                                            <TextBlock Width="56" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                       Text="{Binding Settings.SystemVolume, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                        <ui:LevelMeter Height="6" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                       Level="{Binding Service.SystemPeak, Mode=OneWay}" />
                                    </StackPanel>
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Mikrofon" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Mikrofon aufnehmen">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.CaptureMicrophone}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Aufnahmegerät">
                                    <ComboBox Width="300" ItemsSource="{Binding InputDevices}" DisplayMemberPath="Name"
                                              SelectedValuePath="Id" SelectedValue="{Binding Settings.MicrophoneDeviceId}"
                                              IsEnabled="{Binding Settings.CaptureMicrophone}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Lautstärke in der Aufnahme" ShowDivider="False">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Slider Width="220" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    Value="{Binding Settings.MicrophoneVolume}" VerticalAlignment="Center"
                                                    IsEnabled="{Binding Settings.CaptureMicrophone}" />
                                            <TextBlock Width="56" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                       Text="{Binding Settings.MicrophoneVolume, StringFormat={}{0:P0}}" />
                                        </StackPanel>
                                        <ui:LevelMeter Height="6" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                       Level="{Binding Service.MicPeak, Mode=OneWay}" />
                                    </StackPanel>
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Tonspur" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Audio-Bitrate" Description="AAC, 48 kHz Stereo.">
                                    <ComboBox Width="200" ItemsSource="{Binding AudioBitrateOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.AudioBitrateKbps}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Ton-Versatz"
                                               Description="Nur nötig, wenn Ton und Bild nicht zusammenpassen. Positive Werte verzögern den Ton. Startet den Puffer neu.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="200" Minimum="-500" Maximum="500" TickFrequency="10" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.AudioOffsetMs}" VerticalAlignment="Center" />
                                        <TextBlock Width="64" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Settings.AudioOffsetMs, StringFormat={}{0} ms}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Geräteliste" Description="Neu angeschlossenes Headset fehlt in der Auswahl?" ShowDivider="False">
                                    <Button Content="Aktualisieren" Command="{Binding RefreshDevicesCommand}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Speichern -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Speichern" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}" Text="Wohin Clips geschrieben werden und wie sie heißen." />

                        <TextBlock Text="Ablage" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Speicherort">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="300" Text="{Binding Settings.OutputFolder}" VerticalAlignment="Center" />
                                        <Button Content="Ändern …" Margin="8,0,0,0" Command="{Binding BrowseOutputFolderCommand}" />
                                        <Button Content="Öffnen" Margin="8,0,0,0" Command="{Binding OpenOutputFolderCommand}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Unterordner je Spiel" Description="Legt für jedes erkannte Spiel einen eigenen Ordner an, z. B. Counter-Strike 2.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.GameSubfolders}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Dateiname" Description="Platzhalter: {game}, {date}, {time} und {tag} (z. B. 3K bei Highlights).">
                                    <StackPanel>
                                        <TextBox Width="300" Text="{Binding Settings.FileNameTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Style="{StaticResource Text.Faint}" Margin="2,6,0,0" MaxWidth="300" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding FileNamePreview}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Als Standard-MP4 speichern" ShowDivider="False"
                                               Description="Schreibt den Clip ohne Neukodierung in ein normales MP4, das jedes Schnittprogramm öffnet. Aus: schneller, aber fragmentiertes MP4.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.RemuxToStandardMp4}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Rückmeldung" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Benachrichtigung anzeigen" Description="Windows-Hinweis mit Spiel, Länge und Größe des Clips.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.NotifyOnSave}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Ton abspielen" Description="Kurzer Signalton beim Speichern per Hotkey, damit du im Spiel weißt, dass es geklappt hat. Automatische Highlights bleiben stumm." ShowDivider="False">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.PlaySoundOnSave}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Hotkeys -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Hotkeys" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}"
                                   Text="Feld anklicken und die Tastenkombination drücken. Rücktaste oder Entf entfernt sie, Esc bricht ab. Hotkeys funktionieren auch, während ein Spiel im Vordergrund ist." />

                        <TextBlock Text="Aufnahme" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Replay speichern" Description="Speichert den gesamten Puffer.">
                                    <ui:HotkeyBox Hotkey="{Binding Settings.HotkeySave}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Kurzen Clip speichern" Description="Speichert nur das Ende des Puffers.">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox Width="140" ItemsSource="{Binding ShortClipOptions}" DisplayMemberPath="Label"
                                                  SelectedValuePath="Value" SelectedValue="{Binding Settings.ShortClipSeconds}" Margin="0,0,10,0" />
                                        <ui:HotkeyBox Hotkey="{Binding Settings.HotkeySaveShort}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Replay pausieren oder fortsetzen" ShowDivider="False">
                                    <ui:HotkeyBox Hotkey="{Binding Settings.HotkeyToggle}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,14,0,0" Foreground="{StaticResource Brush.Warn}" Style="{StaticResource Text.Muted}"
                                   Text="{Binding HotkeyErrors}"
                                   Visibility="{Binding HotkeyErrors, Converter={StaticResource EmptyToVisible}, ConverterParameter=invert}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Highlights -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Highlights" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}"
                                   Text="Speichert automatisch einen Clip, wenn du Kills machst. Kills kurz hintereinander werden zu einem Clip zusammengefasst und als 2K, 3K oder Ace benannt." />

                        <TextBlock Text="Clip-Länge" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Vorlauf" Description="Sekunden vor dem ersten Kill.">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="200" Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.HighlightPreRollSec}" VerticalAlignment="Center" />
                                        <TextBlock Width="48" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Settings.HighlightPreRollSec, StringFormat={}{0} s}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Nachlauf" Description="Sekunden nach dem letzten Kill. Weitere Kills in dieser Zeit verlängern den Clip." ShowDivider="False">
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="200" Minimum="1" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.HighlightPostRollSec}" VerticalAlignment="Center" />
                                        <TextBlock Width="48" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Settings.HighlightPostRollSec, StringFormat={}{0} s}" />
                                    </StackPanel>
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Counter-Strike 2" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Automatische Clips"
                                               Description="Nutzt Valves offizielle Game State Integration. Kein Eingriff ins Spiel, VAC-sicher.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.Cs2Enabled}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Spiel anbinden" Description="Legt eine kleine Konfigurationsdatei im CS2-Ordner ab. Danach CS2 einmal neu starten.">
                                    <StackPanel HorizontalAlignment="Right">
                                        <Button Content="Einrichten" Command="{Binding InstallCs2Command}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Cs2InstallStatus}" Style="{StaticResource Text.Muted}" MaxWidth="320"
                                                   TextAlignment="Right" Margin="0,6,0,0" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Status">
                                    <TextBlock Text="{Binding Service.Cs2StatusText}" Style="{StaticResource Text.Value}" MaxWidth="340" TextAlignment="Right" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Spielmodi" Description="Deathmatch und Gelegenheitsspiele erzeugen sonst sehr viele Clips.">
                                    <ComboBox Width="260" ItemsSource="{Binding Cs2ModeOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Cs2Modes}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Clip erstellen">
                                    <ComboBox Width="200" ItemsSource="{Binding KillOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.Cs2MinKills}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Aufwärmphase ignorieren" ShowDivider="False">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.Cs2IgnoreWarmup}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="VALORANT (experimentell)" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1" Padding="20,16">
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="13">
                                        <Run Text="VALORANT bietet keine offizielle Schnittstelle für Spielereignisse, und Vanguard verbietet jeden Zugriff auf den Spielspeicher. ClipRing erkennt Kills deshalb am Kill-Banner im Bild. Dafür braucht es einmalig Vorlagen: Erkennung einschalten, im Schießstand einen Bot erledigen und sofort" />
                                        <Run Text="{Binding Settings.HotkeyValorantCalibrate, Mode=OneWay}" Foreground="{StaticResource Brush.Text}" />
                                        <Run Text="drücken. Zwei bis drei Vorlagen reichen meist." />
                                    </TextBlock>
                                </Border>
                                <ui:SettingRow Title="Automatische Clips">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.ValorantEnabled}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Vorlage aufnehmen" Description="Hotkey, der den aktuellen Bannerbereich als Vorlage speichert.">
                                    <ui:HotkeyBox Hotkey="{Binding Settings.HotkeyValorantCalibrate}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Status">
                                    <TextBlock Text="{Binding Service.ValorantStatusText}" Style="{StaticResource Text.Value}" MaxWidth="340" TextAlignment="Right" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Auslöseschwelle" Description="Live-Übereinstimmung links, Schwelle rechts. Löst es zu oft aus, die Schwelle erhöhen.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Width="52" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Service.ValorantScore, StringFormat={}{0:P0}}" />
                                        <Slider Width="180" Minimum="0.3" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                Value="{Binding Settings.ValorantThreshold}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <TextBlock Width="52" Margin="12,0,0,0" Style="{StaticResource Text.Value}" VerticalAlignment="Center"
                                                   Text="{Binding Settings.ValorantThreshold, StringFormat={}{0:P0}}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Clip erstellen">
                                    <ComboBox Width="200" ItemsSource="{Binding KillOptions}" DisplayMemberPath="Label"
                                              SelectedValuePath="Value" SelectedValue="{Binding Settings.ValorantMinKills}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Bannerbereich" Description="Ausschnitt des Bildschirms in Prozent. Nach einer Änderung neue Vorlagen aufnehmen.">
                                    <Grid Width="330">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Links" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Width="56" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Settings.ValorantRegionX}" />
                                        <TextBlock Grid.Column="2" Width="44" TextAlignment="Right" Style="{StaticResource Text.Value}" VerticalAlignment="Center" Text="{Binding Settings.ValorantRegionX, StringFormat={}{0:P0}}" />
                                        <TextBlock Grid.Row="1" Text="Oben" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="0.95" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Settings.ValorantRegionY}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" TextAlignment="Right" Style="{StaticResource Text.Value}" VerticalAlignment="Center" Text="{Binding Settings.ValorantRegionY, StringFormat={}{0:P0}}" />
                                        <TextBlock Grid.Row="2" Text="Breite" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.05" Maximum="0.6" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Settings.ValorantRegionW}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" TextAlignment="Right" Style="{StaticResource Text.Value}" VerticalAlignment="Center" Text="{Binding Settings.ValorantRegionW, StringFormat={}{0:P0}}" />
                                        <TextBlock Grid.Row="3" Text="Höhe" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0.05" Maximum="0.6" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding Settings.ValorantRegionH}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" TextAlignment="Right" Style="{StaticResource Text.Value}" VerticalAlignment="Center" Text="{Binding Settings.ValorantRegionH, StringFormat={}{0:P0}}" />
                                    </Grid>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Vorlagen" Description="Fehlerhafte Vorlagen einfach im Ordner löschen (.gray und .png)." ShowDivider="False">
                                    <Button Content="Ordner öffnen" Command="{Binding OpenValorantTemplatesCommand}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Spiele -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Spiele" Style="{StaticResource Text.PageTitle}" />
                        <TextBlock Style="{StaticResource Text.Lead}"
                                   Text="Das Spiel im Vordergrund bestimmt Ordner und Dateinamen. Erkannt wird über eine eingebaute Liste, Steam-, Epic- und GOG-Bibliotheken und Vollbild-Fenster." />

                        <TextBlock Text="Erkennung" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Vollbild-Programme als Spiel behandeln"
                                               Description="Findet auch Spiele außerhalb der Bibliotheken. Browser und Videoplayer sind ausgenommen.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.DetectFullscreenApps}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Gerade im Vordergrund" ShowDivider="False">
                                    <TextBlock Text="{Binding Service.ForegroundText}" Style="{StaticResource Text.Value}" MaxWidth="380" TextAlignment="Right" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Eigene Namen" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}" Padding="20,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Muted}"
                                           Text="Eine Zeile pro Spiel im Format Prozessname = Name, zum Beispiel FactoryGame = Satisfactory. Der Name wird als Ordner und im Dateinamen verwendet." />
                                <TextBox Margin="0,12,0,0" Height="110" AcceptsReturn="True" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" Text="{Binding CustomNamesText}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Immer als Spiel" Style="{StaticResource Text.SectionTitle}" />
                                <Border Style="{StaticResource Sheet}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Muted}" Text="Ein Prozessname pro Zeile, ohne .exe." />
                                        <TextBox Margin="0,12,0,0" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding ExtraGamesText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nie als Spiel" Style="{StaticResource Text.SectionTitle}" />
                                <Border Style="{StaticResource Sheet}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Text.Muted}" Text="Zum Beispiel Programme, die im Vollbild laufen." />
                                        <TextBox Margin="0,12,0,0" Height="110" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding ExcludedProcessesText}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================================== Allgemein -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Style="{StaticResource Page}">
                        <TextBlock Text="Allgemein" Style="{StaticResource Text.PageTitle}" />

                        <TextBlock Text="Programmstart" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Mit Windows starten">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.StartWithWindows}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Beim Windows-Start nur im Infobereich" Description="Das Fenster bleibt verborgen, das Replay läuft trotzdem.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.StartMinimized}" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Schließen lässt ClipRing weiterlaufen" ShowDivider="False"
                                               Description="Das X verkleinert in den Infobereich. Beenden geht über das Symbol dort.">
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Settings.CloseToTray}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="FFmpeg und Hardware" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Gefunden">
                                    <TextBlock Text="{Binding Service.FfmpegText}" Style="{StaticResource Text.Value}" MaxWidth="420" TextAlignment="Right" />
                                </ui:SettingRow>
                                <ui:SettingRow Title="Eigener Pfad" Description="Leer lassen, dann sucht ClipRing neben dem Programm, im Ordner ffmpeg und im PATH.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBox Width="300" Text="{Binding Settings.FfmpegPath}" VerticalAlignment="Center" />
                                        <Button Content="Auswählen …" Margin="8,0,0,0" Command="{Binding BrowseFfmpegCommand}" />
                                    </StackPanel>
                                </ui:SettingRow>
                                <ui:SettingRow Title="Hardware neu erkennen" ShowDivider="False"
                                               Description="Nach einem Treiber-Update oder Monitorwechsel: sucht FFmpeg, Monitore und Encoder neu.">
                                    <Button Content="Neu erkennen" Command="{Binding RedetectCommand}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Fehlersuche" Style="{StaticResource Text.SectionTitle}" />
                        <Border Style="{StaticResource Sheet}">
                            <StackPanel>
                                <ui:SettingRow Title="Protokoll" Description="Enthält die genauen FFmpeg-Befehle und Fehlermeldungen." ShowDivider="False">
                                    <Button Content="Protokollordner öffnen" Command="{Binding OpenLogsCommand}" />
                                </ui:SettingRow>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
